# Optional site URL for canonical tags, sitemap, and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AdSense integration
# Set these in production to enable site-wide Auto ads.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Optional manual ad unit slot. Leave blank if you only use Auto ads.
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT_ID=

# Server-only TomTom Search API key for global address autocomplete.
# Add the real value to .env.local and Vercel; never prefix it with NEXT_PUBLIC_.
TOMTOM_SEARCH_API_KEY=
